root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# The width of Prettier (printWidth)
[*.{js,mjs,cjs,ts,mts,cts,vue,json,css,scss,html}]
max_line_length = 120

[*.{sh,bash}]
indent_size = 2
max_line_length = 80

[*.md]
trim_trailing_whitespace = false
indent_size = unset

[{Makefile,*.mk}]
indent_style = tab
